# Monarch Money Credentials
# Copy this file to .env and fill in your credentials
# These will also need to be set as environment variables in Vercel

# ============================================
# METHOD 1: Token Auth (for Google OAuth users)
# ============================================
# If you login with Google, you need to extract your session token from the browser.
# 
# How to get your token:
# 1. Go to https://app.monarchmoney.com and login with Google
# 2. Open browser DevTools (F12 or Cmd+Option+I)
# 3. Go to Application tab → Local Storage → https://app.monarchmoney.com
# 4. Find the key "mm_at" or look in Network tab for any request header "Authorization: Token ..."
# 5. Copy the token value (without "Token " prefix)
#
# Note: This token may expire periodically - you may need to refresh it

MONARCH_TOKEN=your_session_token_here

# ============================================
# METHOD 2: Password Auth (email/password users)
# ============================================
# If you login with email/password (not Google OAuth), use these instead:

# MONARCH_EMAIL=your@email.com
# MONARCH_PASSWORD=your_password

# Optional: If you have MFA enabled, you can provide your TOTP secret key
# This allows automatic MFA code generation
# MONARCH_MFA_SECRET=your_totp_secret_key
