{% if status == 'error' %}
  {% render "error_msg", 
    message: message,
    url: trmnl.plugin_settings.custom_fields_values.api_url
  %}
{% else %}
  {% assign show_category = trmnl.plugin_settings.custom_fields_values.show_category %}
  {% assign show_date = trmnl.plugin_settings.custom_fields_values.show_date %}
  {% assign show_pending = trmnl.plugin_settings.custom_fields_values.show_pending %}

  <div class="layout">
    <div class="columns">
      <div class="column">
        <div class="list" 
          data-list-limit="true" 
          data-list-max-height="420" 
          data-list-hidden-count="false"
          data-list-max-columns="1">        
          {% for item in items limit:7 %}
            {% render "transaction_compact", 
              cssClasses: "pr--2",
              merchant: item.merchant,
              amount_formatted: item.amount_formatted,
              is_income: item.is_income,
              is_expense: item.is_expense,
              pending: item.pending,
              category_icon: item.category_icon,
              show_pending: show_pending
            %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% unless trmnl.plugin_settings.custom_fields_values.show_title_bar == false or trmnl.plugin_settings.custom_fields_values.show_title_bar == 'false' %}
  {% render "title_bar", title: 'Monarch', description: description %}
{% endunless %}
