<!-- Monarch Money TRMNL Plugin - Shared Components -->
<style>
  .tx-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 6px 0;
    border-bottom: 1px solid #ccc;
  }
  .tx-row:last-child {
    border-bottom: none;
  }
  .tx-left {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .tx-merchant {
    font-weight: bold;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tx-meta {
    font-size: 13px;
    color: #666;
    margin-top: 2px;
    margin-left: 30px;
  }
  .tx-amount {
    font-weight: bold;
    font-size: 18px;
    text-align: right;
    white-space: nowrap;
    min-width: 90px;
  }
  .tx-pending {
    font-size: 9px;
    padding: 2px 5px;
    border: 1px solid #888;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .tx-icon {
    font-size: 20px;
    width: 24px;
    text-align: center;
  }
</style>

{% template transaction_row %}
  <div class="tx-row">
    <div class="tx-left">
      <div class="tx-merchant">
        {% if show_category == true or show_category == 'true' %}
          <span class="tx-icon">{{ category_icon }}</span>
        {% endif %}
        <span>{{ merchant | truncate: 22 }}</span>
        {% if pending == true %}
          {% if show_pending == true or show_pending == 'true' %}
            <span class="tx-pending">pending</span>
          {% endif %}
        {% endif %}
      </div>
      <div class="tx-meta">
        {% if show_category == true or show_category == 'true' %}
          {{ category }}
        {% endif %}
        {% if show_account == true or show_account == 'true' %}
          {% if show_category == true or show_category == 'true' %} · {% endif %}
          {{ account | truncate: 15 }}
        {% endif %}
        {% if show_date == true or show_date == 'true' %}
          {% if show_category == true or show_category == 'true' or show_account == true or show_account == 'true' %} · {% endif %}
          {{ date_formatted }}
        {% endif %}
      </div>
    </div>
    <div class="tx-amount">
      {{ amount_formatted }}
    </div>
  </div>
{% endtemplate %}

{% template transaction_compact %}
  <div class="tx-row">
    <div class="tx-merchant" style="flex: 1; display: flex; align-items: center; gap: 6px;">
      <span class="tx-icon" style="font-size: 16px;">{{ category_icon }}</span>
      <span>{{ merchant | truncate: 16 }}</span>
    </div>
    <div class="tx-amount" style="font-size: 16px;">
      {{ amount_formatted }}
    </div>
  </div>
{% endtemplate %}

{% template error_msg %}
  <div class="layout layout--col">
    <span class="title">{{ message }}</span>
    <span class="description">{{ url }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <span class="title">💰 {{ title | default: 'Monarch Money' }}</span>
    <span class="instance">{{ description | truncate: 40 }}</span>
  </div>
{% endtemplate %}
