<!-- Monarch Money TRMNL Plugin - Shared Components -->
<style>
  .tx-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 8px 0;
    border-bottom: 1px solid #ccc;
  }
  .tx-row:last-child {
    border-bottom: none;
  }
  .tx-left {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }
  .tx-merchant {
    font-weight: bold;
    font-size: 16px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tx-meta {
    font-size: 12px;
    color: #666;
    margin-top: 2px;
  }
  .tx-amount {
    font-weight: bold;
    font-size: 16px;
    text-align: right;
    white-space: nowrap;
    padding-left: 12px;
  }
  .tx-pending {
    font-size: 10px;
    padding: 2px 6px;
    border: 1px solid #888;
    border-radius: 3px;
    margin-left: 6px;
  }
  .tx-icon {
    margin-right: 6px;
  }
</style>

{% template transaction_row %}
  <div class="tx-row">
    <div class="tx-left">
      <div class="tx-merchant">
        {% if show_category == true or show_category == 'true' %}
          <span class="tx-icon">{{ category_icon }}</span>
        {% endif %}
        {{ merchant | truncate: 20 }}
        {% if pending == true %}
          {% if show_pending == true or show_pending == 'true' %}
            <span class="tx-pending">PENDING</span>
          {% endif %}
        {% endif %}
      </div>
      <div class="tx-meta">
        {% if show_category == true or show_category == 'true' %}
          {{ category }}
        {% endif %}
        {% if show_account == true or show_account == 'true' %}
          {% if show_category == true or show_category == 'true' %} · {% endif %}
          {{ account | truncate: 15 }}
        {% endif %}
        {% if show_date == true or show_date == 'true' %}
          {% if show_category == true or show_category == 'true' or show_account == true or show_account == 'true' %} · {% endif %}
          {{ date_formatted }}
        {% endif %}
      </div>
    </div>
    <div class="tx-amount">
      {{ amount_formatted }}
    </div>
  </div>
{% endtemplate %}

{% template transaction_compact %}
  <div class="tx-row">
    <div class="tx-merchant" style="flex: 1;">
      <span class="tx-icon">{{ category_icon }}</span>
      {{ merchant | truncate: 16 }}
    </div>
    <div class="tx-amount">
      {{ amount_formatted }}
    </div>
  </div>
{% endtemplate %}

{% template error_msg %}
  <div class="layout layout--col">
    <span class="title">{{ message }}</span>
    <span class="description">{{ url }}</span>
  </div>
{% endtemplate %}

{% template title_bar %}
  <div class="title_bar">
    <span class="title">💰 {{ title | default: 'Monarch Money' }}</span>
    <span class="instance">{{ description | truncate: 40 }}</span>
  </div>
{% endtemplate %}
